isyco 0.4

# Sonda: dividir "a;b;c" en un arreglo fijo con centinela. El core no tiene
# arreglo de longitud dinámica, ni tuplas, ni valor ausente: la única forma es
# "capacidad máxima + contador", y el corte depende de que `or` haga
# cortocircuito de verdad (si evalúa fila[n], es INDEX_OUT_OF_BOUNDS).
struct Campos { valores: [str<16>; 4], cantidad: i32 }

fn dividir(fila: str<64>) -> Campos {
    let out: [str<16>; 4] = ["", "", "", ""];
    let k: i32 = 0;
    let desde: i64 = 0;
    let i: i64 = 0;
    let n: i64 = len(fila);
    while i <= n {
        if i == n or fila[i] == 59 {
            out[k] = slice(fila, desde, i) as str<16>;
            k = k + 1;
            desde = i + 1;
        }
        i = i + 1;
    }
    return Campos { valores: out, cantidad: k };
}

fn main(fila: str<64>) -> i32 !emit {
    let c: Campos = dividir(fila);
    let j: i32 = 0;
    while j < c.cantidad {
        emit c.valores[j];
        j = j + 1;
    }
    return c.cantidad;
}
