isyco 0.4

# Gemelo del azúcar V2 escrito a mano HOY (sin for): es la predicción de `steps`
# del gate F2.4 ítem 2 y el executable check del expected 17 de 403_for_enteros.
fn main() -> i32 {
    let xs: [i32; 4] = [2, 3, 5, 7];
    let total: i32 = 0;
    let i: i64 = -1;
    while i + 1 < 4 {
        i = i + 1;
        let x: i32 = xs[i];
        total = total + x;
    }
    return total;
}
