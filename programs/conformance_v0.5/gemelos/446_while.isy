isyco 0.4

# Gemelo del 446 con la forma larga: la copia se reasigna adentro del cuerpo y el str no se
# toca. Cabecera 0.4, como la del 444.
fn main() -> i64 !emit {
    let s: str<4> = "aaa";
    let i: i64 = -1;
    while i + 1 < len(s) {
        i = i + 1;
        let c: u8 = s[i];
        c = 65;
        emit c;
    }
    emit s[0];
    return len(s);
}
