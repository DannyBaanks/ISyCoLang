isyco 0.4

# Gemelo V2 de 405_for_copia: la copia del elemento se reasigna y el arreglo no se toca.
fn main() -> i32 !emit {
    let xs: [i32; 3] = [1, 2, 3];
    let i: i64 = -1;
    while i + 1 < 3 {
        i = i + 1;
        let x: i32 = xs[i];
        x = x * 10;
    }
    emit xs[0];
    emit xs[2];
    return xs[1];
}
