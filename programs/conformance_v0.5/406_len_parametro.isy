isyco 0.5
# V1: len de un parámetro-arreglo es estático; i: i64 es el contador del for gemelo.
fn suma(a: [i32; 6]) -> i32 {
    let i: i64 = 0;
    let total: i32 = 0;
    while i < len(a) {
        total = total + a[i];
        i = i + 1;
    }
    return total;
}

fn main() -> i32 {
    let xs: [i32; 6] = [1, 2, 3, 4, 5, 6];
    return suma(xs);
}
